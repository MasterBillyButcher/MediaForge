# --- Database -------------------------------------------------------------
# SQLite file (directory must exist and be writable).
# Leave unset in Docker — the entrypoint defaults to $MEDIA_DATA_DIR/db/custom.db
DATABASE_URL=file:./db/custom.db

# --- Single-volume deployments (Render disk / Fly.io volume / Docker) ------
# One root for ALL persistent data: database, uploaded/result files, playlist
# jobs. Point it at your mounted disk path and the app sorts the rest out.
# MEDIA_DATA_DIR=/data

# --- Playlist worker (optional) -------------------------------------------
# Leave unset for single-host / Docker deployments (worker on :3030 next to the
# web app, reached via the /pw rewrite). For split deployments where the
# playlist worker runs on its own host, set its absolute public URL here:
# NEXT_PUBLIC_PLAYLIST_WORKER_URL=https://worker.example.com

# --- Playlist worker internal URL (optional, server-side health check) ----
# Only needed if the worker is not on 127.0.0.1:3030 of the same machine.
# PLAYLIST_WORKER_INTERNAL_URL=http://worker:3030/pw/health
